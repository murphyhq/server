{
  "uid": "murphy-app",
  "title": "Murphy: app",
  "tags": [
    "murphy",
    "app"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Crashes",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Uncaught exceptions per minute, by app version",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service_version) (count_over_time({service_name=\"murphy-app\"} |= \"uncaught exception\" [1m]))",
          "legendFormat": "{{service_version}}",
          "refId": "A",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
