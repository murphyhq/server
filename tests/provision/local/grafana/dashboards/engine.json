{
  "uid": "murphy-engine",
  "title": "Murphy: engine",
  "description": "Incident decisions: messages handled by event type, the database behind them, runtime and container.",
  "tags": [
    "murphy"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Messages",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Messages handled per second, by outcome",
      "description": "Rejected or retried messages show up as their own lines.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "links": [],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (murphy_event_type, murphy_outcome) (rate(murphy_messages_processed_total{service_namespace=\"murphy\", service_name=\"engine\"}[$__rate_interval]))",
          "legendFormat": "{{murphy_event_type}} {{murphy_outcome}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Handling time",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "links": [],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, murphy_event_type) (rate(murphy_message_process_duration_seconds_bucket{service_namespace=\"murphy\", service_name=\"engine\"}[$__rate_interval])))",
          "legendFormat": "{{murphy_event_type}} p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, murphy_event_type) (rate(murphy_message_process_duration_seconds_bucket{service_namespace=\"murphy\", service_name=\"engine\"}[$__rate_interval])))",
          "legendFormat": "{{murphy_event_type}} p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "Database",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "table",
      "title": "Database per message",
      "description": "What one message costs the database, heaviest first. Database time counts the queries' own duration; waiting counts time getting a pooled connection.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (murphy_event_type) (rate(murphy_message_db_queries_count{service_namespace=\"murphy\", service_name=\"engine\"}[$__rate_interval]))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (murphy_event_type) (rate(murphy_message_db_queries_sum{service_namespace=\"murphy\", service_name=\"engine\"}[$__rate_interval])) / sum by (murphy_event_type) (rate(murphy_message_db_queries_count{service_namespace=\"murphy\", service_name=\"engine\"}[$__rate_interval]))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, murphy_event_type) (rate(murphy_message_db_time_seconds_bucket{service_namespace=\"murphy\", service_name=\"engine\"}[$__rate_interval])))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (murphy_event_type) (rate(murphy_message_db_time_seconds_sum{service_namespace=\"murphy\", service_name=\"engine\"}[$__rate_interval])) / sum by (murphy_event_type) (rate(murphy_message_process_duration_seconds_sum{service_namespace=\"murphy\", service_name=\"engine\"}[$__rate_interval]))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, murphy_event_type) (rate(murphy_message_db_wait_seconds_bucket{service_namespace=\"murphy\", service_name=\"engine\"}[$__rate_interval])))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Per second",
              "Value #B": "Queries, average",
              "Value #C": "Database time, p99",
              "Value #D": "Share of time in the database",
              "Value #E": "Waiting for a connection, p99"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Database time, p99",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "time|wait"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Share"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Per second"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      }
    },
