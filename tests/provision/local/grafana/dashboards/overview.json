      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_namespace=\"murphy\", service_name=\"ingest\", http_response_status_code=~\"2..\"}[$__rate_interval]))",
          "legendFormat": ""
