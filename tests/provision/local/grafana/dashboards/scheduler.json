{
  "uid": "murphy-scheduler",
  "title": "Murphy: scheduler",
  "description": "Scheduled messages going out when due, the database it reads them from, runtime and container.",
  "tags": [
    "murphy"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Scheduled messages",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Published per second, by topic",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "links": [],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (murphy_topic) (rate(murphy_messages_published_total{service_namespace=\"murphy\", service_name=\"scheduler\"}[$__rate_interval]))",
          "legendFormat": "{{murphy_topic}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "How late messages went out",
      "description": "Time between a message being due and the broker confirming it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "links": [],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, murphy_kind) (rate(murphy_scheduled_message_delay_seconds_bucket{service_namespace=\"murphy\", service_name=\"scheduler\"}[$__rate_interval])))",
          "legendFormat": "{{murphy_kind}} p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, murphy_kind) (rate(murphy_scheduled_message_delay_seconds_bucket{service_namespace=\"murphy\", service_name=\"scheduler\"}[$__rate_interval])))",
          "legendFormat": "{{murphy_kind}} p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Stored",
      "description": "Events not yet published and timers not yet due.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
