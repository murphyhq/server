{
  "mappings": [
    {
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/relay/v1/pushes",
        "bodyPatterns": [
          {
            "matchesJsonPath": "$[?(@.token =~ /gone-.+/)]"
          }
        ]
      },
      "response": {
        "status": 410,
        "headers": {
          "Content-Type": "application/problem+json"
        },
        "jsonBody": {
          "title": "Gone",
          "status": 410,
          "detail": "the device is gone; stop sending to this handle"
        }
      }
    },
    {
      "priority": 2,
      "request": {
        "method": "POST",
        "urlPath": "/relay/v1/pushes",
        "headers": {
          "Authorization": {
            "equalTo": "Bearer mik_local-development-key"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"id\": \"{{jsonPath request.body '$.id'}}\", \"status\": \"sent\"}",
        "transformers": [
          "response-template"
        ]
      }
    }
  ]
}
